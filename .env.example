# Read-only Xiaohongshu collector. The CLI is installed as xhs 0.2.0 in Docker.
XHS_BACKEND=cli
XHS_CLI_PATH=xhs
XHS_PROFILE_URL=https://xhslink.cn/o/Dfkx6Lhilv
XHS_NOTE_URL=https://xhslink.cn/o/46BbiPl8OPJ
XHS_NICKNAME=琢磨鸟
XHS_ENGLISH_NAME=thewoodpecker
XHS_EXPECTED_USER_ID=67d21d20000000000e01d41e
XHS_CONFIG_DIR=./data/xhs-config
XHS_CACHE_DIR=./data/xhs-cache
XHS_COOKIE_FILE=./data/cookies/xhs.cookie
XHS_RATE=2s
XHS_PROFILE_CANDIDATE_LIMIT=10

# Safe default. Publish requires all gates in app/config.py.
MODE=draft
REPOST_AUTHORIZED=false
X_API_BASE_URL=https://api.x.com
X_AUTH_MODE=oauth2
# v2 requires current project access. Use v1.1 only with OAuth1 legacy apps.
X_POST_API_VERSION=v2
X_USER_ACCESS_TOKEN=
X_BEARER_TOKEN=
# OAuth 1.0a compatibility fields. Required when X_AUTH_MODE=oauth1.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_MEDIA_UPLOAD_BASE_URL=https://upload.x.com
X_MEDIA_UPLOAD_PATH=/2/media/upload
X_MAX_CHARS=280
X_TAG_COUNT=4
# Space-separated pool. Each note gets a stable random subset; source-platform tags are excluded.
X_TAG_POOL=#PortraitPhotography #Portraits #PortraitMood #PortraitInspiration #PortraitArt #PortraitStyle #BeautyPortrait #BeautyPhotography #WomensPortraits #WomenInPhotography #FemalePortrait #ModelPhotography #ModelPortrait #FashionPortrait #FashionPhotography #EditorialPortrait #EditorialFashion #StreetPortrait #StreetPhotography #LifestylePhotography #CinematicPortrait #CinematicPhotography #MoodyPortraits #NaturalLightPortrait #GoldenHourPortrait #SoftLight #CreativePortrait #FineArtPortrait #VisualStorytelling #PhotoInspiration #PhotographyLovers #PhotographyDaily #PhotoOfTheDay #Portraiture #BeautifulWomen #BeautyInspiration #StyleInspiration #OutfitInspiration #FilmLook #AestheticPhotography #ArtPhotography #PhotographyCommunity #BehindThePortrait

# Public translation API. MyMemory needs no API key; an email is optional.
TRANSLATION_PROVIDER=mymemory
MYMEMORY_BASE_URL=https://api.mymemory.translated.net
MYMEMORY_EMAIL=
LIBRETRANSLATE_BASE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# Optional compatibility provider, never selected by default.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DATA_DIR=./data
DB_PATH=./data/rednote_to_x.sqlite3
REQUEST_TIMEOUT_SECONDS=45
RETRY_ATTEMPTS=3
LOG_LEVEL=INFO
TZ=Asia/Singapore

# Optional persistent browser backend. Install requirements-browser.txt first.
BROWSER_PROFILE_DIR=./data/browser-profile
BROWSER_EXECUTABLE_PATH=
BROWSER_HEADLESS=false
BROWSER_LOGIN_TIMEOUT_SECONDS=180
